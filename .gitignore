.DS_Store
/fin.xcodeproj/*
# ...except the SwiftPM pins: without them a fresh checkout floats SwiftTerm
# past 1.18.0 (`from:` in project.yml) to a release that doesn't compile.
!/fin.xcodeproj/project.xcworkspace/
/fin.xcodeproj/project.xcworkspace/*
!/fin.xcodeproj/project.xcworkspace/xcshareddata/
/fin.xcodeproj/project.xcworkspace/xcshareddata/*
!/fin.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/fin.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/fin.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
xcuserdata/
DerivedData/
/build-*/
/Generated/
.build/
.swiftpm/
.playwright-mcp/
*.log
.claude/

# One-time App Store Connect setup screenshots from initial TestFlight bring-up —
# not project source, some show developer-account/business details.
asc-*.png
add-testers-dialog.png
dev-account-membership.png
tester-added.png
testflight-group.png
scripts/cloud-agent/dist/
/datasets/

# Local model-factory artifacts: the training venv and candidate adapters/fused models
scripts/model-factory/.venv/
/models/
