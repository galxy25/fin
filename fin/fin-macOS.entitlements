<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.levischoen.fin</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.dev.levischoen.fin</string>
	</array>
	<!-- Device-wide config sync (SyncedDeviceConfig), same as the iOS entitlement:
	     iCloud Key-Value Storage needs this on top of the CloudKit container. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Same purpose as the iOS aps-environment entitlement: CloudKit's silent sync
	     pushes need APNs; macOS spells the key with the full prefix. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple: the control plane's real per-user identity (multi-tenancy) —
	     replaces the single shared bearer token every account used to share. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Communication notifications, same purpose as the iOS entitlement (design
	     §3.3/§5.1): Fin's replies arrive like messages from a contact "Fin" with a
	     Reply field in Notification Center. macOS support is UNVERIFIED end to end
	     (design §3.6); the code degrades to a plain alert if updating(from:) throws. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- Time Sensitive interruption level for "needs input" pushes. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- SiriKit: in-app INSendMessageIntent handling (FinMessageIntentHandler). -->
	<key>com.apple.developer.siri</key>
	<true/>
</dict>
</plist>
