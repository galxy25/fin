<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- fin-agentd as a resident site on this Mac. Rendered by install.sh: every
	     __PLACEHOLDER__ becomes an absolute path under the installing user's home.
	     See README.md; design: docs/SITES.md section 9.

	     Program is the LAUNCHER, not the daemon. RunAtLoad + KeepAlive mean launchd
	     starts this at every login and respawns it forever, so every reason to start
	     has to be checked at launch time, in the launcher: is the brain up and serving
	     the configured model, and does the login shell still honour LC_FIN_AGENT? An
	     installer-time check cannot cover a 3am login with LM Studio closed. The
	     launcher backs off and exits 0 rather than letting a brainless daemon push
	     "giving up" to the owner's phone every 90s and eat the inbox backlog. -->
	<key>Label</key>
	<string>dev.levischoen.fin.agentd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__FIN_LAUNCHER__</string>
		<string>__FIN_AGENTD_CONFIG__</string>
	</array>
	<!-- The daemon's state directory: the audit log, the applied-id ledger
	     (fin-agentd-directives.json) and routing-registry.json all live here. -->
	<key>WorkingDirectory</key>
	<string>__FIN_AGENTD_HOME__</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- Plain true, not SuccessfulExit:false — a clean exit 0 must respawn too. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<!-- agentd.out.log is a SECOND, UNREDACTED copy of every directive, every inbox
	     message and every model reply: Daemon.swift's log() writes them to stdout, and
	     MemoryRedactor runs only on the way off the machine (transcript uplink, notify).
	     The directory is 0700, so this is a retention question, not an access one — a
	     credential dictated into the inbox from a phone would otherwise sit here in
	     plaintext forever. rotate-logs.sh caps it (and agentd.err.log and audit.jsonl)
	     at 8 MiB with two generations, and refresh.sh runs it before each restart. -->
	<key>StandardOutPath</key>
	<string>__FIN_AGENTD_LOG_DIR__/agentd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__FIN_AGENTD_LOG_DIR__/agentd.err.log</string>
</dict>
</plist>
