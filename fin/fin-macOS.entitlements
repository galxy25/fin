<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.levischoen.fin</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.dev.levischoen.fin</string>
	</array>
	<!-- Device-wide config sync (SyncedDeviceConfig), same as the iOS entitlement:
	     iCloud Key-Value Storage needs this on top of the CloudKit container. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Same purpose as the iOS aps-environment entitlement: CloudKit's silent sync
	     pushes need APNs; macOS spells the key with the full prefix. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
