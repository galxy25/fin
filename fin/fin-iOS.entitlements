<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.levischoen.fin</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.dev.levischoen.fin</string>
	</array>
	<!-- Device-wide config sync (SyncedDeviceConfig): the control-plane endpoint and
	     the supervision enabled flag ride iCloud Key-Value Storage, which needs its
	     own entitlement on top of the CloudKit container. Without it, KVS's
	     synchronize() returns false and the app silently runs config local-only. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- CloudKit's cross-device sync pushes ride APNs; without this entitlement the
	     silent-push subscription is never delivered and a second device only syncs on
	     foreground launch. "development" is flipped to "production" automatically at
	     App Store/TestFlight submission. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple: the control plane's real per-user identity (multi-tenancy) —
	     replaces the single shared bearer token every account used to share. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Communication notifications (docs/CARPLAY-IMESSAGE-DESIGN.md §3.3/§5.1):
	     lets the app's local banners and the fin-nse extension's rewritten pushes
	     carry an INSendMessageIntent donation, so Fin's replies show with an avatar
	     and — with Announce Notifications on — Siri reads them aloud in CarPlay /
	     on AirPods and takes a spoken reply. Self-serve capability, no review. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- Time Sensitive: "Fin needs your input" pushes carry
	     interruption-level time-sensitive, because Announce's default filter is
	     "Time Sensitive and Direct Messages". Self-serve capability. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- SiriKit: the in-app INSendMessageIntent handler (FinMessageIntentHandler)
	     is a SiriKit Messaging-domain handler, and Siri only dispatches to apps
	     with the Siri capability. Self-serve. -->
	<key>com.apple.developer.siri</key>
	<true/>
	<!-- Share extension (docs/XANADU.md "Share extension (v1.1)"): the App Group
	     holds what fin-share reads (endpoint, primary agent, current thread);
	     the second keychain access group holds the extension's device-only copy
	     of the control-plane token (FinAppGroup.swift). The app's OWN group is
	     listed first on purpose: the first entry is the default for every
	     keychain write that names no group, so existing items keep landing
	     exactly where they always did. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.levischoen.fin</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.levischoen.fin</string>
		<string>$(AppIdentifierPrefix)dev.levischoen.fin.shared</string>
	</array>
</dict>
</plist>
