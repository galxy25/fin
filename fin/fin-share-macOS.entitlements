<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- fin-share (macOS): fin-share.entitlements plus the App Sandbox the Mac
	     App Store requires of every embedded extension, and outgoing network for
	     the upload-then-send flow (control plane + presigned S3 PUT). Shared
	     files arrive as sandbox extensions on the item providers; no file
	     entitlement is needed to read them. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.levischoen.fin</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.levischoen.fin.shared</string>
	</array>
</dict>
</plist>
